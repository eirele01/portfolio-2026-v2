# Copy to .env.local for local overrides. Never commit real keys.

# ── Contact form [CONTACT-01] — full walkthrough: docs/CONTACT-SETUP.md ──
# Resend API key (dashboard.resend.com → API Keys). Required for /api/contact;
# without it the form answers with a friendly "not connected yet" error.
RESEND_API_KEY=

# Where form submissions are delivered. Defaults to the address in
# src/content/facts.ts (person.email) when empty.
CONTACT_TO=

# Verified sender identity, e.g.:
#   Eirele Joven Boter <hello@eirelejovenboter.com>
# Defaults to Resend's sandbox sender (onboarding@resend.dev), which can
# only deliver to your own Resend account address until your domain is
# verified in Resend (SPF/DKIM records → Cloudflare DNS).
CONTACT_FROM=

# ── Site metadata ──────────────────────────────────────────────────────
# Canonical site URL, e.g. https://eirelejovenboter.com (used by metadata).
NEXT_PUBLIC_SITE_URL=

# ── Media (optional) ───────────────────────────────────────────────────
# Base URL for externally-hosted media, if used.
# NEXT_PUBLIC_MEDIA_BASE_URL=
