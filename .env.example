# Copy to .env.local for local overrides. Never commit real keys.

# ── Contact form [CONTACT-01] — full walkthrough: docs/CONTACT-SETUP.md ──
# Resend API key (dashboard.resend.com → API Keys). Required for /api/contact;
# without it the form answers with a friendly "not connected yet" error.
# After deploying, GET /api/contact is a wiring self-check (shows whether
# the key is set and where submissions go — no secrets, sends nothing).
RESEND_API_KEY=

# Where form submissions are delivered. Defaults to the address in
# src/content/facts.ts (person.email) when empty.
CONTACT_TO=

# Verified sender identity, e.g.:
#   Eirele Joven Boter <hello@eirelejovenboter.com>
# Set the value EXACTLY in one of the two shapes Resend accepts —
# name@domain.com or Name <name@domain.com> — no stray brackets: one
# leftover < or > from a half-copied template makes Resend reject every
# submission with 422 (the route repairs that typo class since
# [CONTACT-04] and GET /api/contact prints a warning; fix it anyway).
# Defaults to Resend's sandbox sender (onboarding@resend.dev), which can
# only deliver to your own Resend account address until your domain is
# verified in Resend (SPF/DKIM records → Cloudflare DNS).
CONTACT_FROM=

# ── Site metadata ──────────────────────────────────────────────────────
# Canonical site URL, e.g. https://eirelejovenboter.com (used by metadata).
# Optional on Vercel [SEO-01]: without it, the Vercel production domain is
# picked up automatically for canonical/sitemap/robots/JSON-LD. Set it once
# your custom domain is live — it always wins. See docs/SEO-SETUP.md.
NEXT_PUBLIC_SITE_URL=

# Google Search Console meta-tag verification token (optional — the DNS
# TXT method needs no code). Content of the google-site-verification value
# Search Console shows on the "HTML tag" verification card.
# GOOGLE_SITE_VERIFICATION=

# ── Media (optional) ───────────────────────────────────────────────────
# Base URL for externally-hosted media, if used.
# NEXT_PUBLIC_MEDIA_BASE_URL=
